# Qloo hackathon API key (server-only, never NEXT_PUBLIC_)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional LLM provider key. The app works WITHOUT it (deterministic "Qloo-only"
# pitches). With it, the agent drafts tailored pitches and drives tool calls.
# Any OpenAI-compatible chat-completions endpoint works.
# OPENAI_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
